{
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/index.html" },
    { "source": "/notifications", "destination": "/index.html" },
    { "source": "/planning", "destination": "/index.html" },
    { "source": "/my-shifts/:shiftId", "destination": "/index.html" },
    { "source": "/events/:eventId/shifts/:shiftId", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
